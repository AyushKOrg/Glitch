# Set these in Vercel -> Project -> Settings -> Environment Variables
# (or `vercel env add`). Never commit a real .env.

# --- Supabase: Project Settings -> API Keys (or API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# The public "anon" / publishable key. Safe for browsers.
SUPABASE_ANON_KEY=
# The SECRET "service_role" key. Server only. Never put it in the HTML or share it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Flash mode (Gemini). Also powers web search ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Cognition mode (OpenRouter). Pick a model that supports tools if you can ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Optional: only these emails may chat (comma separated). Empty = any signed-in account ---
ALLOWED_EMAILS=
