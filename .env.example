# Set these in Vercel -> Project -> Settings -> Environment Variables
# (or `vercel env add`). Never commit a real .env.

# Postgres connection string. Easiest: Vercel dashboard -> Storage -> Create -> Neon
# (free), which adds DATABASE_URL to the project for you. Tables are created automatically.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Server-side secret mixed into every password before hashing. 32+ random characters.
# Keep it out of the database. If you change it later, existing passwords stop working.
PASSWORD_PEPPER=change-me-32-or-more-random-characters

# Sign-up is invite-only: people need this code to create an account.
# Unset = nobody can register. The first account created becomes the admin.
GLITCH_SIGNUP_CODE=change-me-invite-code

# Public URL of your PC bridge (Cloudflare Tunnel / ngrok), no trailing slash
GLITCH_PC_URL=https://your-tunnel.trycloudflare.com
# Must match GLITCH_BRIDGE_SECRET in the PC's .env
GLITCH_BRIDGE_SECRET=another-long-random-string

# Optional fallback when the PC is off (plain chat, no tools)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
