{
  "name": "Glitch",
  "short_name": "Glitch",
  "description": "Your personal AI assistant",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#f6f5fb",
  "theme_color": "#7c3aed",
  "icons": [
    {
      "src": "/android-touch-icon-192.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-touch-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
