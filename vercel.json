{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/images.js": {
      "maxDuration": 60
    },
    "api/vip-rotate.js": {
      "maxDuration": 60
    },
    "api/vip-regenerate.js": {
      "maxDuration": 60
    },
    "api/creative-outline.js": {
      "maxDuration": 60
    },
    "api/creative-ppt.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(self), display-capture=(self), geolocation=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/vip-rotate",
      "schedule": "30 18 * * *"
    }
  ]
}
