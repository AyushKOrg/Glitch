# Set these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit a real .env file or provider key.

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon/publishable key. Safe to expose to the browser when RLS is configured.
SUPABASE_ANON_KEY=

# --- Flash mode (Gemini) and Google Search grounding ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional comma-separated fallback list for Google Search grounding.
GOOGLE_SEARCH_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# Optional search fallback. Keep this server-side.
TAVILY_API_KEY=

# --- Cognition mode (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Optional access restriction ---
# Comma-separated email addresses. Empty = any signed-in account.
ALLOWED_EMAILS=
